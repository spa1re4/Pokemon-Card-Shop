@model IEnumerable<PokemonCardShop.Models.PokemonCard>

@{
    ViewData["Title"] = "Каталог карт";
}

<h1 class="mb-4">Каталог карт</h1>

@if (User.IsInRole("Admin"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Добавить новую карту</a>
    </p>
}

<table class="table table-striped table-bordered align-middle">
    <thead>
        <tr>
            <th>Фото</th>
            <th>Название</th>
            <th>Серия</th>
            <th>Редкость</th>
            <th>Цена</th>
            <th>Количество</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td style="width: 120px;">
                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl"
                             alt="@item.Name"
                             style="width: 90px; height: 120px; object-fit: contain; border-radius: 8px;" />
                    }
                    else
                    {
                        <span class="text-muted">Нет фото</span>
                    }
                </td>

                <td>@item.Name</td>
                <td>@item.Series</td>
                <td>@item.Rarity</td>
                <td>$@item.Price.ToString("0.00")</td>
                <td>@item.StockQuantity</td>

                <td style="min-width: 320px;">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm mb-1">
                        Подробнее
                    </a>

                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm mb-1">
                            Изменить
                        </a>

                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm mb-1">
                            Удалить
                        </a>
                    }

                    <a asp-controller="Cart" asp-action="AddToCart" asp-route-id="@item.Id"
                       class="btn btn-success btn-sm mb-1">
                        В корзину
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>