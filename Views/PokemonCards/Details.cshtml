@model PokemonCardShop.Models.PokemonCard

@{
    ViewData["Title"] = "Информация о карте";
}

<h1>Информация о карте</h1>

<div class="card" style="max-width: 36rem;">
    <div class="card-body">
        <h3 class="card-title">@Model.Name</h3>
        <p><strong>Серия:</strong> @Model.Series</p>
        <p><strong>Редкость:</strong> @Model.Rarity</p>
        <p><strong>Цена:</strong> $@Model.Price.ToString("0.00")</p>
        <p><strong>Количество:</strong> @Model.StockQuantity</p>
        <p><strong>Описание:</strong> @Model.Description</p>

        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid mt-3" />
        }
    </div>
</div>

<p class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Изменить</a>
    <a asp-action="Index" class="btn btn-secondary">Назад</a>
</p>