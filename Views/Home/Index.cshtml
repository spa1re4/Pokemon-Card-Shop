@model IEnumerable<PokemonCardShop.Models.PokemonCard>

@{
    ViewData["Title"] = "Главная";
}

<section class="hero-section text-center text-white">
    <div class="hero-overlay">
        <div class="container py-5">
            <h1 class="display-3 fw-bold">Магазин карт Pokémon</h1>
            <p class="lead mt-3 mb-4">
                Добро пожаловать в магазин коллекционных карт Pokémon
            </p>

            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <a asp-controller="PokemonCards" asp-action="Index" class="btn btn-warning btn-lg px-4">
                    Открыть каталог
                </a>
                <a asp-controller="PokemonCards" asp-action="Create" class="btn btn-light btn-lg px-4">
                    Добавить карту
                </a>
            </div>
        </div>
    </div>
</section>

<section class="container my-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold">Последние карты</h2>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card shop-card h-100 shadow-sm">
                        <div class="shop-image-wrap">
                            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" class="card-img-top shop-image" />
                            }
                        </div>

                        <div class="card-body d-flex flex-column">
                            <h4>@item.Name</h4>
                            <p>Цена: $@item.Price.ToString("0.00")</p>

                            <div class="mt-auto d-grid gap-2">
                                <a asp-controller="PokemonCards" asp-action="Details" asp-route-id="@item.Id"
                                   class="btn btn-outline-primary">
                                    Подробнее
                                </a>

                                <a asp-controller="Cart" asp-action="AddToCart" asp-route-id="@item.Id"
                                   class="btn btn-success">
                                    В корзину
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>